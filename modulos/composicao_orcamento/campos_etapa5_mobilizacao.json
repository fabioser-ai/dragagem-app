      "origem": "etapa2.cotacoes",
      "destino": "itens.preco_unitario",
      "modo": "preferencial_com_entrada_manual_alertada"
    },
    {
      "origem": "cadastro_mao_de_obra_futuro",
      "destino": "equipe.valor_hora",
      "modo": "preferencial_com_entrada_manual_alertada"
